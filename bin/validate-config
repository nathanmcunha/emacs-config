#!/usr/bin/env bash
# Comprehensive Org file validation for Emacs configurations

CONFIG_FILE="$1"
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "$CONFIG_FILE" ]; then
    echo "Usage: $0 <file.org>"
    exit 1
fi

if [ ! -f "$CONFIG_FILE" ]; then
    echo "❌ Error: File $CONFIG_FILE not found."
    exit 1
fi

echo "🔍 Validating $CONFIG_FILE..."
echo ""

HAS_ERROR=0

# Test 1: Check for balanced blocks with better error reporting
echo "📋 Test 1: Checking for balanced #+begin_src / #+end_src blocks..."
BLOCKS_OUTPUT=$(awk '
  BEGIN { has_error = 0; count = 0; in_src_block = 0; }
  tolower($0) ~ /^[[:space:]]*#\+begin_src([[:space:]]|$)/ {
    count++;
    stack[count] = NR;
    in_src_block = 1;
    lines_in_block[NR] = NR;  # Mark this line as start of block
  }
  tolower($0) ~ /^[[:space:]]*#\+end_src([[:space:]]|$)/ {
    if (count > 0) {
        count--;
        in_src_block = 0;
    } else {
        print "❌ EXTRA_END:" NR ":" $0;
        has_error = 1
    }
  }
  END {
    if (has_error) exit 1
    if (count > 0) {
        print "❌ MISSING_END:" count ":";
        for (i=1; i<=count; i++) {
            print "BLOCK_START:" stack[i];
        }
        exit 1
    }
    exit 0
  }
' "$CONFIG_FILE")

if [ $? -ne 0 ]; then
    echo "   ❌ Block balance check failed!"
    echo "$BLOCKS_OUTPUT" | while read line; do
        if [[ $line == "EXTRA_END:"* ]]; then
            line_num=$(echo "$line" | cut -d: -f2)
            echo "      Line $line_num: Extra #+end_src"
        elif [[ $line == "MISSING_END:"* ]]; then
            echo "      Missing #+end_src for blocks at:"
            echo "$BLOCKS_OUTPUT" | grep "BLOCK_START:" | cut -d: -f2 | while read start_line; do
                echo "        - Line $start_line"
            done
        fi
    done
    HAS_ERROR=1
else
    echo "   ✅ Org blocks are balanced."
fi
echo ""

# Test 2: Check for Lisp patterns outside blocks
echo "📝 Test 2: Checking for Lisp code outside #+begin_src blocks..."
LISP_OUTSIDE=$(awk '
  BEGIN { in_code_block = 0; issue_count = 0; }
  tolower($0) ~ /^[[:space:]]*#\+begin_src/ {
    in_code_block = 1;
  }
  tolower($0) ~ /^[[:space:]]*#\+end_src/ {
    in_code_block = 0;
  }
  !in_code_block {
    # Check for Lisp patterns that suggest code
    if (/^\s*\(defun\s+\w+/) {
        print "DEFUN:" NR ":" $0;
        issue_count++;
    }
    if (/^\s*\(use-package/) {
        print "USE_PACKAGE:" NR ":" $0;
        issue_count++;
    }
    if (/^\s*\(with-eval-after-load/) {
        print "WITH_EVAL:" NR ":" $0;
        issue_count++;
    }
  }
  END { exit issue_count; }
' "$CONFIG_FILE")

LISP_ERROR_COUNT=$?
if [ $LISP_ERROR_COUNT -gt 0 ]; then
    echo "   ❌ Found $LISP_ERROR_COUNT Lisp patterns outside code blocks:"
    echo "$LISP_OUTSIDE" | while read line; do
        type=$(echo "$line" | cut -d: -f1)
        line_num=$(echo "$line" | cut -d: -f2)
        content=$(echo "$line" | cut -d: -f3-)

        case $type in
            DEFUN) echo "      Line $line_num: Function definition" ;;
            USE_PACKAGE) echo "      Line $line_num: use-package declaration" ;;
            WITH_EVAL) echo "      Line $line_num: with-eval-after-load" ;;
        esac
    done
    HAS_ERROR=1
else
    echo "   ✅ No Lisp code outside code blocks."
fi
echo ""

# Test 2b: Stale tangle check — warn if .org newer than .el
echo "⏱️  Test 2b: Checking for stale tangle..."
EL_FILE="${CONFIG_FILE%.org}.el"
if [ -f "$EL_FILE" ]; then
    ORG_TIME=$(stat -c %Y "$CONFIG_FILE" 2>/dev/null)
    EL_TIME=$(stat -c %Y "$EL_FILE" 2>/dev/null)
    if [ "$ORG_TIME" -gt "$EL_TIME" ]; then
        echo "   ⚠️  $EL_FILE is stale (org newer than el)"
        echo "      Re-tangle: emacs --batch -l org --eval \"(org-babel-tangle-file \\\"$CONFIG_FILE\\\")\""
    else
        echo "   ✅ Elisp file is up to date"
    fi
else
    echo "   ℹ️  No corresponding .el file (not tangling?)"
fi
echo ""

# Test 3: Horizontal indentation check (common mistake: wrong level)
echo "🔧 Test 3: Checking for indentation and structure issues..."
INDENT_ISSUES=$(awk '
  BEGIN { in_src_block = 0; block_start = 0; }
  tolower($0) ~ /^[[:space:]]*#\+begin_src/ {
    in_src_block = 1;
    block_start = NR;
  }
  tolower($0) ~ /^[[:space:]]*#\+end_src/ {
    if (in_src_block && NR == block_start + 1) {
        print "EMPTY_BLOCK:" block_start;
    }
    in_src_block = 0;
  }
  END { exit 0; }
' "$CONFIG_FILE")

if echo "$INDENT_ISSUES" | grep -q "EMPTY_BLOCK:"; then
    echo "   ⚠️  Found potentially empty code blocks:"
    echo "$INDENT_ISSUES" | grep "EMPTY_BLOCK:" | cut -d: -f2 | while read line_num; do
        echo "      Line $line_num: Empty block"
    done
    echo ""
else
    echo "   ✅ No obvious empty blocks."
fi
echo ""

# Test 4: Tangle structure check, then load + byte-compile existing .el
echo "🔄 Test 4: Tangling, loading, and byte-compiling..."
ABS_CONFIG="$(realpath "$CONFIG_FILE")"
EL_FILE="${CONFIG_FILE%.org}.el"
# 4a: Tangle — verifies org structural integrity (exit code only)
if emacs -Q --batch -l org --eval "(require 'ob-emacs-lisp)" \
    --eval "(setq org-confirm-babel-evaluate nil)" \
    --eval "(condition-case e (org-babel-tangle-file \"$ABS_CONFIG\") (error (kill-emacs 1)))" 2>/dev/null; then
    echo "   ✅ Tangling successful"
else
    echo "   ❌ Tangling failed"
    HAS_ERROR=1
fi
# 4b: Load — catches incomplete expressions (the bug I hit)
if [ -f "$EL_FILE" ]; then
    if emacs -Q --batch \
        --eval "(condition-case e (progn (load \"$EL_FILE\" nil :nomessage) (kill-emacs 0)) (error (message \"LOAD-FAIL: %s\" (error-message-string e)) (kill-emacs 1)))" 2>&1 | grep -q "LOAD-FAIL"; then
        echo "   ❌ Load failed (unbalanced parens or syntax error)"
        HAS_ERROR=1
    else
        echo "   ✅ Loaded without errors"
    fi
    # 4c: Byte-compile — catches runtime issues
    if emacs -Q --batch \
        --eval "(condition-case e (progn (byte-compile-file \"$EL_FILE\") (kill-emacs 0)) (error (message \"COMPILE-FAIL: %s\" (error-message-string e)) (kill-emacs 1)))" 2>&1 | grep -q "COMPILE-FAIL"; then
        echo "   ❌ Byte-compilation failed"
        HAS_ERROR=1
    else
        echo "   ✅ Byte-compilation successful"
    fi
else
    echo "   ⚠️  No .el file to load (tangle first)"
fi
echo ""

# Test 5: Basic syntax sanity check
echo "🔬 Test 5: Syntax sanity check..."
SYNTAX_ISSUES=$(grep -Pn '[^\x00-\x7E\x09\x0A\x0D]' "$CONFIG_FILE" 2>/dev/null || true)
if [ -n "$SYNTAX_ISSUES" ]; then
    echo "   ⚠️  Non-ASCII characters found:"
    echo "$SYNTAX_ISSUES" | sed 's/^/      /'
else
    echo "   ✅ No obvious syntax issues"
fi
echo ""

# Final result
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $HAS_ERROR -eq 0 ]; then
    echo "✅ All validation checks passed!"
    exit 0
else
    echo "❌ Validation failed! Please fix the issues above."
    echo ""
    echo "💡 Tips for fixing config.org issues:"
    echo "   1. Ensure all Lisp code is inside #+begin_src ... #+end_src blocks"
    echo "   2. Check that #+begin_src and #+end_src pairs match exactly"
    echo "   3. Verify proper indentation and structure"
    echo "   4. Test tangling: emacs -Q --batch -l org -f org-babel-tangle-file config.org"
    exit 1
fi
