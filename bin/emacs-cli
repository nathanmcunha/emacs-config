#!/usr/bin/env bash
set -e
set -o pipefail

# --- Environment Setup ---
# Explicitly add standard paths to ensure Git is found
export PATH="/usr/bin:/usr/local/bin:$PATH"

# Load mise environment if available
if command -v mise &> /dev/null; then
    eval "$(mise activate bash --shims)"
fi

# --- Configuration Paths ---
EMACS="emacs"
EMACSCLIENT="emacsclient"
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INIT_FILE="$PROJECT_ROOT/init.el"

# --- Options ---
VERBOSE=false
BACKGROUND=false
TIMEOUT=600  # Default timeout: 10 minutes (in seconds)

function print_usage() {
    echo "Usage: $(basename "$0") [command] [options]"
    echo ""
    echo "Commands:"
    echo "  sync, install     Refresh package index and install missing packages"
    echo "  update, upgrade   Update all packages to latest versions"
    echo "  purge             Remove .local/packages cache"
    echo "  check, validate   Validate syntax of config.org and core Elisp files"
    echo "  doctor            Check system health and config.org integrity"
    echo "  help, --help, -h  Show this help message"
    echo ""
    echo "Options (for sync/update):"
    echo "  -v, --verbose      Show detailed progress"
    echo "  -b, --background   Run in background (log to file)"
    echo "  -t, --timeout N    Set timeout in seconds (default: 600)"
}

function parse_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -b|--background)
                BACKGROUND=true
                shift
                ;;
            -t|--timeout)
                if [ -z "${2:-}" ]; then
                    log_error "--timeout requires a value in seconds"
                    return 2
                fi
                if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
                    log_error "--timeout must be a positive integer (seconds)"
                    return 2
                fi
                TIMEOUT="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                log_error "Unknown option: $1"
                return 2
                ;;
            *)
                log_error "Unexpected argument: $1"
                return 2
                ;;
        esac
    done
}

function log_info() {
    echo -e "\033[1;34m==>\033[0m $1"
}

function log_success() {
    echo -e "\033[1;32m✅\033[0m $1"
}

function log_error() {
    echo -e "\033[1;31m❌\033[0m $1"
}

function log_warn() {
    echo -e "\033[1;33m⚠️\033[0m $1"
}

function stop_server() {
    log_info "Stopping Emacs service (systemd)..."
    if systemctl --user is-active --quiet emacs.service; then
        systemctl --user stop emacs.service
        log_success "Emacs service stopped."
    else
        log_info "Emacs service is not running."
    fi
}

function start_server() {
    log_info "Starting Emacs service (systemd)..."
    if systemctl --user start emacs.service; then
        log_success "Emacs service started."
    else
        log_error "Failed to start Emacs service via systemd."
    fi
}

function prune_elc() {
    log_info "Pruning stale .elc files and tangled config.el..."
    rm -f "$PROJECT_ROOT/init.elc" "$PROJECT_ROOT/early-init.elc"
    rm -f "$PROJECT_ROOT/config.el"
    find "$PROJECT_ROOT" -maxdepth 1 -name "*.elc" -delete
    log_success "Stale .elc and config.el pruned (will retangle from config.org)."
}

function check_duplicates() {
    if [ -x "$PROJECT_ROOT/bin/validate-duplicates" ]; then
        log_info "Checking for duplicate use-package declarations..."
        if ! "$PROJECT_ROOT/bin/validate-duplicates" "$PROJECT_ROOT/config.org"; then
            log_error "Duplicate use-package declarations found. Fix config.org before continuing."
            return 1
        fi
    else
        echo "⚠️  validate-duplicates not found, skipping duplicate check."
    fi
}

function cmd_check() {
    local exit_code=0

    check_duplicates || exit_code=1

    log_info "Validating config.org structure..."
    if [ -f "$PROJECT_ROOT/bin/validate-config" ]; then
        if "$PROJECT_ROOT/bin/validate-config" "$PROJECT_ROOT/config.org"; then
            log_success "config.org structure and syntax are valid."
        else
            log_error "config.org validation failed!"
            exit_code=1
        fi
    else
        echo "⚠️  validate-config not found, skipping Org validation."
    fi

    log_info "Validating Elisp syntax..."
    if [ -f "$PROJECT_ROOT/bin/validate-lisp-syntax.py" ]; then
        local elisp_files=("$PROJECT_ROOT/init.el" "$PROJECT_ROOT/early-init.el")
        [ -f "$PROJECT_ROOT/config.el" ] && elisp_files+=("$PROJECT_ROOT/config.el")

        if python3 "$PROJECT_ROOT/bin/validate-lisp-syntax.py" "${elisp_files[@]}"; then
            log_success "Core Elisp files and config.el are valid."
        else
            log_error "Elisp syntax errors detected!"
            exit_code=1
        fi
    else
        echo "⚠️  validate-lisp-syntax.py not found, skipping Elisp validation."
    fi

    return $exit_code
}

function cmd_sync() {
    # Handle background mode
    if [ "$BACKGROUND" = true ]; then
        local log_file="$PROJECT_ROOT/.local/emacs-sync-$(date +%Y%m%d-%H%M%S).log"
        log_info "Running sync in background. Log: $log_file"
        mkdir -p "$(dirname "$log_file")"
        nohup "$0" sync --timeout "$TIMEOUT" > "$log_file" 2>&1 &
        local pid=$!
        echo "Background process PID: $pid"
        echo "Monitor with: tail -f $log_file"
        return 0
    fi

    check_duplicates || return 1

    stop_server
    log_info "Refreshing package index and installing missing packages..."
    log_info "Timeout set to ${TIMEOUT} seconds"
    prune_elc

    local log_file="/tmp/emacs-sync-output-$$.log"
    set +e
    timeout "$TIMEOUT" "$EMACS" -Q --batch \
           --eval "(progn (setq user-emacs-directory \"$PROJECT_ROOT/\") (setq gc-cons-threshold 100000000))" \
           --eval "(package-refresh-contents)" \
           -l "$INIT_FILE" 2>&1 | tee "$log_file"
    local exit_code=${PIPESTATUS[0]}
    set -e

    if [ $exit_code -eq 124 ]; then
        log_error "Sync timed out after ${TIMEOUT} seconds"
        tail -20 "$log_file"
        rm -f "$log_file"
        return $exit_code
    elif [ $exit_code -ne 0 ]; then
        log_error "Sync failed with exit code $exit_code"
        tail -20 "$log_file"
        rm -f "$log_file"
        return $exit_code
    fi

    rm -f "$log_file"
    start_server
    return 0
}

function cmd_update() {
    # Handle background mode
    if [ "$BACKGROUND" = true ]; then
        local log_file="$PROJECT_ROOT/.local/emacs-update-$(date +%Y%m%d-%H%M%S).log"
        log_info "Running update in background. Log: $log_file"
        mkdir -p "$(dirname "$log_file")"
        nohup "$0" update --timeout "$TIMEOUT" > "$log_file" 2>&1 &
        local pid=$!
        echo "Background process PID: $pid"
        echo "Monitor with: tail -f $log_file"
        return 0
    fi

    stop_server
    log_info "Updating packages..."
    log_info "Timeout set to ${TIMEOUT} seconds"

    local log_file="/tmp/emacs-update-output-$$.log"
    set +e
    timeout "$TIMEOUT" "$EMACS" -Q --batch \
           --eval "(progn (setq user-emacs-directory \"$PROJECT_ROOT/\") (setq gc-cons-threshold 100000000))" \
           --eval "(package-refresh-contents)" \
           --eval "(package-update-all)" 2>&1 | tee "$log_file"
    local exit_code=${PIPESTATUS[0]}
    set -e

    if [ $exit_code -eq 124 ]; then
        log_error "Update timed out after ${TIMEOUT} seconds"
        tail -20 "$log_file"
        rm -f "$log_file"
        return $exit_code
    elif [ $exit_code -ne 0 ]; then
        log_error "Package update failed with exit code $exit_code"
        tail -20 "$log_file"
        rm -f "$log_file"
        return $exit_code
    fi

    rm -f "$log_file"
    start_server
    return 0
}

function cmd_purge() {
    log_info "Purging .local/packages cache..."
    if [ -d "$PROJECT_ROOT/.local/packages" ]; then
        rm -rf "$PROJECT_ROOT/.local/packages"
        log_success "Purge complete. Run 'sync' to reinstall."
    else
        log_info "No package cache found."
    fi
}

function cmd_doctor() {
    local exit_code=0
    log_info "Running Doctor..."
    echo ""
    echo "=== System Info ==="
    echo "Emacs version: $("$EMACS" --version | head -n 1)"
    echo "Git path: $(command -v git)"
    echo "Working directory: $PROJECT_ROOT"
    echo ""
    echo "=== Configuration ==="
    echo "Init file: $INIT_FILE"
    echo "Config file: $PROJECT_ROOT/config.org"
    echo ""
    echo "=== Configuration Size ==="
    ls -lh "$PROJECT_ROOT/config.org" | awk '{print "config.org size: " $5}'
    echo ""
    echo "=== Validation ==="
    check_duplicates || exit_code=1
    if [ -f "$PROJECT_ROOT/bin/validate-config" ]; then
        echo "Running config.org validation..."
        if ! "$PROJECT_ROOT/bin/validate-config" "$PROJECT_ROOT/config.org"; then
            exit_code=1
        fi
    else
        echo "⚠️ validate-config not found, skipping validation."
    fi

    if [ -f "$PROJECT_ROOT/bin/validate-lisp-syntax.py" ]; then
        echo "Validating Elisp syntax..."
        local elisp_files=("$PROJECT_ROOT/init.el" "$PROJECT_ROOT/early-init.el")
        [ -f "$PROJECT_ROOT/config.el" ] && elisp_files+=("$PROJECT_ROOT/config.el")
        if ! python3 "$PROJECT_ROOT/bin/validate-lisp-syntax.py" "${elisp_files[@]}"; then
            exit_code=1
        fi
    else
        echo "⚠️ validate-lisp-syntax.py not found"
    fi

    if [ -f "$PROJECT_ROOT/config.el" ]; then
        echo "Checking config.el read syntax via Emacs reader..."
        local emacs_read_out
        emacs_read_out=$("$EMACS" -Q --batch \
            --eval "(condition-case err \
                      (progn \
                        (with-temp-buffer \
                          (insert-file-contents \"$PROJECT_ROOT/config.el\") \
                          (goto-char (point-min)) \
                          (condition-case _ \
                            (while t (read (current-buffer))) \
                            (end-of-file nil))) \
                        (message \"config.el: read syntax OK\")) \
                      (error \
                        (message \"config.el read error: %S\" err) \
                        (kill-emacs 1)))" 2>&1)
        local emacs_read_exit=$?
        if [ $emacs_read_exit -ne 0 ]; then
            echo "$emacs_read_out"
            log_error "config.el has read syntax errors — tangled output is broken, fix config.org"
            exit_code=1
        else
            echo "✅ config.el read syntax OK"
        fi
    else
        echo "⚠️ config.el not found (not yet tangled from config.org)"
    fi

    if [ -f "$PROJECT_ROOT/config.el" ]; then
        echo "Byte-compiling config.el (static analysis)..."
        local bc_output bc_exit
        bc_output=$(timeout 60 "$EMACS" -Q --batch \
            -f batch-byte-compile "$PROJECT_ROOT/config.el" 2>&1)
        bc_exit=$?
        rm -f "$PROJECT_ROOT/config.elc"
        if [ $bc_exit -eq 124 ]; then
            echo "⚠️  Byte-compile timed out (config.el too large for static analysis in -Q mode), skipping."
            bc_output=""
        fi

        # Filter noise: only surface compile errors and apostrophe-name free-variable warnings.
        # "function not defined" / "reference to free variable 'evil-*'" are expected
        # (packages not loaded in -Q mode). But ''name' (double-apostrophe) means the symbol
        # itself starts with ' — this is always a \'symbol bug in config.org.
        local bc_errors bc_freevar
        bc_errors=$(echo "$bc_output" | grep ":Error:" || true)
        # Emacs uses Unicode curly quotes in messages: U+2018 (') + ASCII ' + letter = escaped-apostrophe bug.
        # Use Python for reliable Unicode matching (grep -P \x{2018} is locale-sensitive).
        bc_freevar=$(echo "$bc_output" | python3 -c "
import sys, re
for line in sys.stdin:
    if re.search(r\"Warning:.*free variable \u2018'[a-zA-Z]\", line):
        print(line, end='')
" || true)

        if [ -n "$bc_errors" ]; then
            echo "$bc_errors"
            log_error "config.el has byte-compile errors"
            exit_code=1
        elif [ -n "$bc_freevar" ]; then
            echo "$bc_freevar"
            log_error "Symbols with escaped apostrophes found — remove backslash before ' in config.org"
            exit_code=1
        else
            echo "✅ config.el byte-compile OK"
        fi
    fi
    echo ""
    if [ $exit_code -eq 0 ]; then
        log_success "All checks passed!"
    else
        log_error "Some checks failed"
    fi
    return $exit_code
}

# --- Command Dispatch ---
if [ -z "$1" ]; then
    print_usage
    exit 1
fi

# Store the command
COMMAND="$1"
shift

# Parse options (only for sync and update commands)
if [[ "$COMMAND" == "sync" || "$COMMAND" == "install" || "$COMMAND" == "update" || "$COMMAND" == "upgrade" ]]; then
    parse_options "$@" || exit $?
fi

# Execute command
case "$COMMAND" in
    sync|install) cmd_sync ;;
    update|upgrade) cmd_update ;;
    purge) cmd_purge ;;
    check|validate) cmd_check ;;
    doctor) cmd_doctor ;;
    help|--help|-h) print_usage ;;
    *) echo "Unknown command: $COMMAND"; print_usage; exit 1 ;;
esac

exit $?
