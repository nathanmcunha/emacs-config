;; -*- mode: lisp -*-

;; Global snippets (available everywhere)
(today (format-time-string "%Y-%m-%d"))
(time  (format-time-string "%H:%M:%S"))

;; Org-mode snippets
org-mode
(src   "#+begin_src " p n n "#+end_src" >)
(quote "#+begin_quote" n> r n "#+end_quote")
(elisp "#+begin_src emacs-lisp" n> r n "#+end_src" :tangle yes)
(sh    "#+begin_src bash" n> r n "#+end_src")

;; Emacs Lisp snippets
emacs-lisp-mode
(up     "(use-package " p n> ":ensure t" n> ":config" n> p ")")
(defun  "(defun " p " (" p ")" n> "\"" p "\"" n> p ")")
(setq   "(setq " p " " p ")")

;; Java snippets
java-mode
(bc "/*" n " * " p n " */")

;; Python snippets
python-mode
(def   "def " p "(" p "):" n> r p)
(class "class " p ":" n> r p)
(if    "if " p ":" n> r p)
(main  "if __name__ == \"__main__\":" n> r p)
(print "print(" p ")")

;; Fundamental mode (fallback)
fundamental-mode
(sig "-- " n "Nathan Martins Cunha")
